    },
    "./proto": "./proto",
    "./proto/*": "./proto/*",
    "./common": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "nice-grpc": "^2.1.17",
    "nice-grpc-common": "^2.0.4"
  }
