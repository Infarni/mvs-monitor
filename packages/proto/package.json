{
  "name": "@mvs-monitor/proto",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate": "buf generate",
    "build": "buf lint && buf generate && tsc",
    "lint": "buf lint",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "proto"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@types/node": "^26.4.1",
    "ts-proto": "^2.12.1",
